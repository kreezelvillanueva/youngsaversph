---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="section">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lede">This page doesn't exist or has moved. Try one of these instead:</p>
      <ul class="links">
        <li><a class="btn btn-primary" href="/">Home</a></li>
        <li><a class="btn btn-ghost" href="/blog/">Blog</a></li>
        <li><a class="btn btn-ghost" href="/contact/">Contact</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .links { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; margin-top: var(--space-8); }
</style>
