---
import Base from '../layouts/Base.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import { site } from '../data/site';

const channels = [
  { icon: 'msg', label: 'Facebook page', value: site.messenger[0].label, href: site.messenger[0].href },
  { icon: 'msg', label: 'Personal account', value: site.messenger[1].label, href: site.messenger[1].href },
  { icon: 'phone', label: 'Call or text', value: site.phone.display, href: site.phone.href },
  { icon: 'mail', label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { icon: 'fb', label: 'Facebook', value: 'youngsaversph', href: site.social.facebook },
  { icon: 'ig', label: 'Instagram', value: '@youngsaversph', href: site.social.instagram },
];
---

<Base
  title="Contact and Book a Free Assessment"
  description="Message, call or email Kreezel Villanueva, book a free online assessment on Calendly, or send a message. AIA Philippines financial advisor."
>
  <section class="hero">
    <div class="wrap">
      <h1>Contact me</h1>
      <p class="lede">Have a question about insurance or your plan? Reach me directly on any of these, or book a free online assessment below.</p>
      <ul class="channels">
        {channels.map((c) => (
          <li>
            <a class="citem" href={c.href}>
              <span class="tile" aria-hidden="true"><svg class="ico"><use href={`#i-${c.icon}`} /></svg></span>
              <span><small>{c.label}</small><b>{c.value}</b></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt" id="book" aria-labelledby="book-h">
    <div class="wrap">
      <div class="head">
        <h2 id="book-h">Book a free online assessment</h2>
        <p class="lede">A one-on-one video call for a personalized assessment and quotation based on your needs, age and goals. Pick a time that works for you.</p>
      </div>
      <CalendlyEmbed />
    </div>
  </section>

  <section class="section" id="message" aria-labelledby="message-h">
    <div class="wrap two">
      <div class="head">
        <h2 id="message-h">Send a message</h2>
        <p class="lede">Prefer to write? Leave your details and I'll get back to you.</p>
      </div>
      <form id="contact-form" class="card" action="https://api.web3forms.com/submit" method="POST" data-testid="contact-form">
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="New inquiry from youngsaversph.com" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="cf-phone">Phone <span class="opt">(optional)</span></label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="5" required></textarea>
        </div>
        <p class="privacy">{site.privacyLine}</p>
        <button class="btn btn-primary btn-block" type="submit">Send message</button>
        <p id="form-status" role="status" data-testid="form-status"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button')!; btn.disabled = true; status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!(await res.json()).success) throw 0;
      form.reset(); status.textContent = 'Thank you! Your message was sent. I will get back to you soon.';
    } catch { status.textContent = 'Sorry, sending failed. Please message me on Messenger or email me instead.'; }
    btn.disabled = false;
  });
</script>

<style>
  .hero { padding: var(--space-16) 0 var(--space-18); }
  h1 { font-size: var(--text-h1); margin-bottom: var(--space-4); }
  .hero .lede { margin-bottom: var(--space-9); }
  .channels { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); list-style: none; }
  .citem {
    display: flex; gap: 14px; align-items: center; padding: 18px var(--space-5); text-decoration: none; color: var(--color-ink);
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); height: 100%;
    transition: border-color var(--dur-fast), box-shadow var(--dur) var(--ease);
  }
  .citem:hover { border-color: var(--color-maroon); box-shadow: var(--shadow); }
  .tile { width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--color-blush); color: var(--color-maroon); display: grid; place-items: center; flex: none; }
  .citem > span:last-child { min-width: 0; }
  .citem small { display: block; color: var(--color-muted); font-size: .875rem; }
  .citem b { font-size: .9688rem; overflow-wrap: anywhere; }

  .two { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--space-12); align-items: start; }
  form { padding: var(--space-8); display: grid; gap: var(--space-5); }
  .field { display: grid; gap: 6px; }
  label { font-weight: var(--weight-semibold); color: var(--color-ink); font-size: var(--text-sm); }
  .opt { font-weight: 400; color: var(--color-muted); }
  input, textarea {
    font: inherit; font-size: var(--text-md); color: var(--color-ink); width: 100%;
    padding: 12px 14px; border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface);
  }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--color-maroon); outline-offset: 1px; border-color: var(--color-maroon); }
  textarea { resize: vertical; }
  .privacy { font-size: var(--text-sm); color: var(--color-muted); }
  #form-status { font-weight: var(--weight-semibold); color: var(--color-maroon); min-height: 1.5em; }

  @media (max-width: 960px) {
    .hero { padding: var(--space-7) 0 var(--space-16); }
    .channels { grid-template-columns: 1fr; }
    .two { grid-template-columns: 1fr; gap: 0; }
    form { padding: var(--space-5); }
  }
</style>
