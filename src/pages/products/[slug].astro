---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BookingCTA from '../../components/BookingCTA.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { name, description, tagline, heroImage, heroAlt, benefits, forWho, faqs } = entry.data;
const { Content } = await render(entry);
// Illustrations (PNG) sit inside the frame; photos fill it.
const illustration = heroImage?.endsWith('.png');
---

<Base title={name} description={description} image={heroImage}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="tag">AIA Philippines plan</span>
        <h1>{name}</h1>
        <p class="lede">{tagline}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/contact/#book">Book a free online assessment <svg class="ico" aria-hidden="true"><use href="#i-arrow" /></svg></a>
          {faqs.length > 0 && <a class="btn btn-ghost" href="#faq">Read the FAQ</a>}
        </div>
      </div>
      {heroImage && (
        <div class:list={['vis', { illustration }]}>
          <img src={heroImage} alt={heroAlt} decoding="async" fetchpriority="high" />
        </div>
      )}
    </div>
  </section>

  <section class="section section-alt" data-testid="product-benefits" aria-labelledby="benefits-h">
    <div class="wrap">
      <div class="head">
        <h2 id="benefits-h">Key benefits</h2>
      </div>
      <ul class="benefits" role="list">
        {benefits.map((b) => (
          <li class="card benefit">
            <span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="details-h">
    <div class="wrap details-grid">
      <aside class="card who" aria-labelledby="who-h">
        <h2 id="who-h">Who it's for</h2>
        <ul role="list">
          {forWho.map((w) => (
            <li><svg class="ico" aria-hidden="true"><use href="#i-tick" /></svg>{w}</li>
          ))}
        </ul>
      </aside>
      <div>
        <h2 id="details-h">Plan details</h2>
        <div class="prose"><Content /></div>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section-alt" id="faq" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="head">
          <h2 id="faq-h">Frequently asked questions</h2>
        </div>
        <div class="faqs">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}<svg class="ico" aria-hidden="true"><use href="#i-chev-d" /></svg></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <BookingCTA />
</Base>

<style>
  .hero { padding: var(--space-16) 0 var(--space-18); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: var(--space-12); align-items: center; }
  .hero .tag { margin-bottom: var(--space-5); }
  .hero .lede { margin-bottom: var(--space-8); }
  .ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .vis {
    aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden;
    background: var(--color-blush-soft); box-shadow: var(--shadow-lg);
  }
  .vis img { width: 100%; height: 100%; object-fit: cover; }
  .vis.illustration { display: grid; place-items: center; background: var(--color-surface); border: 1px solid var(--color-line); box-shadow: var(--shadow); }
  .vis.illustration img { width: auto; height: auto; max-width: 70%; max-height: 80%; object-fit: contain; }

  .benefits { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-5); list-style: none; }
  .benefit { padding: var(--space-6) 26px; }
  .benefit p { color: var(--color-muted); font-size: var(--text-md); }
  .tile {
    width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--color-blush); color: var(--color-maroon);
    display: grid; place-items: center; margin-bottom: var(--space-4);
  }
  .tile .ico { width: 22px; height: 22px; }
  .benefit h3 { font-size: var(--text-h3-lg); }

  .details-grid { display: grid; grid-template-columns: 360px 1fr; gap: var(--space-14); align-items: start; }
  .who { padding: var(--space-7) 26px; position: sticky; top: var(--space-6); }
  .who h2, .details-grid h2 { font-size: var(--text-h2-sm); }
  .who ul { display: grid; gap: var(--space-3); list-style: none; margin-top: var(--space-4); }
  .who li { display: flex; gap: 10px; align-items: flex-start; color: var(--color-ink); }
  .who li .ico { width: 20px; height: 20px; flex: none; margin-top: .2em; color: var(--color-maroon); }

  .faqs { display: grid; gap: var(--space-3); max-width: var(--measure); }
  details { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  details[open] { box-shadow: var(--shadow); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding: 18px var(--space-5); min-height: 44px; cursor: pointer; list-style: none;
    color: var(--color-ink); font-weight: var(--weight-semibold);
  }
  summary::-webkit-details-marker { display: none; }
  summary .ico { width: 20px; height: 20px; flex: none; color: var(--color-maroon); transition: transform var(--dur) var(--ease); }
  details[open] summary .ico { transform: rotate(180deg); }
  details p { padding: 0 var(--space-5) var(--space-5); color: var(--color-muted); }

  @media (max-width: 960px) {
    .hero { padding: var(--space-7) 0 var(--space-12); }
    .hero-grid, .details-grid { grid-template-columns: 1fr; gap: var(--space-9); }
    .ctas .btn { flex: 1 1 100%; }
    .who { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    summary .ico { transition: none; }
  }
</style>
